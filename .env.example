# ── Service ────────────────────────────────────────────────────────────────
# HOST=127.0.0.1
# PORT=8093
# DATA_DIR=./data
# DEMO=0
# DRY_RUN=0
# LOG_LEVEL=info

# ── Bring! (unofficial API) ────────────────────────────────────────────────
BRING_EMAIL=you@example.com
BRING_PASSWORD=change-me
# List name or list UUID. The engine only mirrors this list.
BRING_LIST=Compras
# BRING_COUNTRY=PT
# BRING_POLL_SECONDS=30

# ── Continente (via the continentept-mcp server) ───────────────────────────
CONTINENTE_EMAIL=you@example.com
CONTINENTE_PASSWORD=change-me
# Where continentept-mcp stores its browser session and favourites snapshot.
# CONTINENTE_DATA_DIR=./data/continente
# Default command resolves node_modules/.bin/continentept-mcp from the project.
# CONTINENTE_MCP_COMMAND=node_modules/.bin/continentept-mcp
# CONTINENTE_MCP_ARGS=
# CONTINENTE_BROWSER_IDLE_SECONDS=120
# CONTINENTE_CART_CHECK_SECONDS=300

# ── Rules ──────────────────────────────────────────────────────────────────
# strict: "may contain gluten" blocks; standard: it is a warning; off: no checks.
GLUTEN_MODE=strict
# The butcher, the fishmonger and fresh produce are always left to you.
EXCLUDED_CATEGORIES=Supermercado/Talho,Supermercado/Peixaria,Supermercado/Frutas e Legumes
# NON_FOOD_PREFIXES=Supermercado/Limpeza,Supermercado/Higiene,...

# ── Matching ───────────────────────────────────────────────────────────────
# AUTO_ADD_THRESHOLD=0.72
# AUTO_ADD_MARGIN=0.12
# MATCH_CANDIDATES=8

# Optional model tie-breaker for ambiguous items. It may only choose among
# candidates that already passed the gluten-free gate.
# LLM_PROVIDER=none|opencode|openai
# LLM_MODEL=opencode/deepseek-v4.1-flash
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# OPENCODE_COMMAND=opencode

# ── Checkout ───────────────────────────────────────────────────────────────
# remove = checking a Bring item off removes it from the cart
# ON_COMPLETE=remove
# ask = notify and wait for a click; auto = check off automatically
# CHECKOUT_MODE=ask
# MAX_CART_EUR=200

# ── Web UI ─────────────────────────────────────────────────────────────────
WEB_PASSWORD=change-me
# At least 24 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# SECURE_COOKIES=1
# Public base URL used in notification links, e.g. https://dragon.tailnet.ts.net:8445
# PUBLIC_URL=

# ── ntfy (optional) ────────────────────────────────────────────────────────
# NTFY_URL=http://127.0.0.1:2586
# NTFY_TOPIC=grocery
# NTFY_TOKEN=
